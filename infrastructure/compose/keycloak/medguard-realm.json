{
  "realm": "medguard",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "admin"
      },
      {
        "name": "engineer"
      },
      {
        "name": "reviewer"
      },
      {
        "name": "viewer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "medguard-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://localhost:8443/*",
        "http://localhost:8443/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "https://localhost:8443",
        "http://localhost:8443",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience-medguard-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "medguard-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "org",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "org",
            "claim.name": "org",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@demo.test",
      "email": "admin@demo.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "org": [
          "demo-org"
        ]
      },
      "realmRoles": [
        "admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "demo-admin",
          "temporary": false
        }
      ],
      "firstName": "Demo",
      "lastName": "Admin"
    },
    {
      "username": "engineer@demo.test",
      "email": "engineer@demo.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "org": [
          "demo-org"
        ]
      },
      "realmRoles": [
        "engineer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "demo-engineer",
          "temporary": false
        }
      ],
      "firstName": "Demo",
      "lastName": "Engineer"
    },
    {
      "username": "reviewer@demo.test",
      "email": "reviewer@demo.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "org": [
          "demo-org"
        ]
      },
      "realmRoles": [
        "reviewer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "demo-reviewer",
          "temporary": false
        }
      ],
      "firstName": "Demo",
      "lastName": "Reviewer"
    },
    {
      "username": "viewer@demo.test",
      "email": "viewer@demo.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "org": [
          "demo-org"
        ]
      },
